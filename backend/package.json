{
  "name": "@balanced/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "admin:create": "node --import tsx scripts/create-admin.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit && eslint src tests scripts",
    "import:manuscript": "node --import tsx scripts/import-manuscript.ts",
    "notifications:run": "node --import tsx scripts/run-notifications.ts",
    "notifications:worker": "node --import tsx scripts/run-notifications.ts --watch",
    "push:generate-vapid": "node --import tsx scripts/run-notifications.ts --generate-vapid"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "better-sqlite3": "^12.4.0",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.0",
    "pdfjs-dist": "^6.5.438",
    "web-push": "^4.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.0"
  }
}
