HOST=127.0.0.1
PORT=4000
DATABASE_PATH=./data/devotional.sqlite
APP_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
NODE_ENV=development

# Administrator security (required in production: minimum 32 random bytes hex/base64)
ADMIN_MFA_ENCRYPTION_KEY=
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=8

# Optional: Dedicated keyed HMAC secrets (defaults to derived runtime secret if omitted in dev; set strong secrets in production)
PASSWORD_RESET_HMAC_KEY=
UNSUBSCRIBE_HMAC_KEY=

# Optional: Paystack payment integration (leave empty until live/test keys are ready)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Production Email Delivery Configuration (Resend Free Tier Prioritized: 100/day, 3,000/month)
# Supported providers: resend | postmark | ses | webhook | capture | none
# DNS setup note: Before going live with any domain (e.g. cossyteens.com), configure and verify SPF, DKIM, and DMARC
# records with your email provider and set EMAIL_DOMAIN_VERIFIED=true only after DNS verification succeeds.
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=noreply@cossyteens.com
EMAIL_FROM_NAME=The Balanced Life Devotional
EMAIL_REPLY_TO=cossyteensconsult@gmail.com
EMAIL_DOMAIN_VERIFIED=false
EMAIL_DAILY_LIMIT=100
EMAIL_MONTHLY_LIMIT=3000
EMAIL_TRANSACTIONAL_RESERVE=20
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# Optional: Amazon SES credentials (when EMAIL_PROVIDER=ses)
EMAIL_SES_REGION=us-east-1
EMAIL_SES_ACCESS_KEY_ID=
EMAIL_SES_SECRET_ACCESS_KEY=

# Optional: Web Push VAPID keys (run `npm run push:generate-vapid` to generate a keypair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:cossyteensconsult@gmail.com

# Optional: Run the background reminder & email scheduler inside the API server process
ENABLE_NOTIFICATION_SCHEDULER=false
NOTIFICATION_WORKER_INTERVAL_MS=60000
